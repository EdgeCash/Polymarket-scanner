# Copy to .env for local runs. Never commit .env.
# Master switch. Everything runs with it off; only the sending is skipped.
ALERTS_ENABLED=false
CLINCHED_OVERS_ENABLED=true
LEAGUES=nfl,cfb
# Flip to true once to get a test message on startup, then back to false.
SEND_TEST_MESSAGE_ON_START=false

# Polling
SCORE_POLL_SECONDS=5
PRICE_POLL_SECONDS=3

# Winner alert rules
MAX_MINUTES_LEFT=8
MIN_FAIR=0.93
MIN_EDGE=0.03
MIN_DOLLARS_AVAILABLE=50
SCORE_COOLDOWN_SECONDS=20
REPEAT_ALERT_MINUTES=5
MAX_ALERTS_PER_DAY=10
CFB_EXTRA_MARGIN=0.01

# Clinched-over rules
MIN_EDGE_CLINCHED=0.02
CLINCH_COOLDOWN_SECONDS=60

# Storage, time zone, web
DATABASE_PATH=/data/diary.db
TZ=America/Chicago
PORT=8080
LOG_LEVEL=INFO

# Secrets: set these on the host, leave them blank here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STATUS_TOKEN=
